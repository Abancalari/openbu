<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Openbu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open .3mf and .gcode files directly (from Downloads, file managers, browsers) -->
            <!-- 1. Match files by extension (file:// or content:// with filename in path) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.3MF" />
                <data android:pathPattern=".*\\.gcode" />
                <data android:pathPattern=".*\\.GCODE" />
                <data android:pathSuffix=".3mf" />
                <data android:pathSuffix=".3MF" />
                <data android:pathSuffix=".gcode" />
                <data android:pathSuffix=".GCODE" />
                <data android:pathPattern=".*\\.3mf\\.txt" />
                <data android:pathPattern=".*\\.3MF\\.txt" />
                <data android:pathPattern=".*\\.gcode\\.txt" />
                <data android:pathPattern=".*\\.GCODE\\.txt" />
                <data android:pathSuffix=".3mf.txt" />
                <data android:pathSuffix=".3MF.txt" />
                <data android:pathSuffix=".gcode.txt" />
                <data android:pathSuffix=".GCODE.txt" />
            </intent-filter>
            <!-- 2. Match files with generic MIME type (*/*) and specific extension in path -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.3MF" />
                <data android:pathPattern=".*\\.gcode" />
                <data android:pathPattern=".*\\.GCODE" />
                <data android:pathSuffix=".3mf" />
                <data android:pathSuffix=".3MF" />
                <data android:pathSuffix=".gcode" />
                <data android:pathSuffix=".GCODE" />
                <data android:pathPattern=".*\\.3mf\\.txt" />
                <data android:pathPattern=".*\\.3MF\\.txt" />
                <data android:pathPattern=".*\\.gcode\\.txt" />
                <data android:pathPattern=".*\\.GCODE\\.txt" />
                <data android:pathSuffix=".3mf.txt" />
                <data android:pathSuffix=".3MF.txt" />
                <data android:pathSuffix=".gcode.txt" />
                <data android:pathSuffix=".GCODE.txt" />
            </intent-filter>
            <!-- 3. Match text/plain when Chrome appends .txt to 3mf or gcode -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.3mf\\.txt" />
                <data android:pathPattern=".*\\.3MF\\.txt" />
                <data android:pathPattern=".*\\.gcode\\.txt" />
                <data android:pathPattern=".*\\.GCODE\\.txt" />
                <data android:pathSuffix=".3mf.txt" />
                <data android:pathSuffix=".3MF.txt" />
                <data android:pathSuffix=".gcode.txt" />
                <data android:pathSuffix=".GCODE.txt" />
            </intent-filter>
            <!-- 4. Match files by 3MF/G-code/ZIP MIME types regardless of URI path scheme (for opaque content:// IDs) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="text/gcode" />
            </intent-filter>
            <!-- Receive shared .3mf and .gcode files from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/x-gcode" />
                <data android:mimeType="text/gcode" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Printer Status Home Screen Widget -->
        <receiver
            android:name=".widget.PrinterWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.cygnusx1.openbu.widget.ACTION_REFRESH_WIDGET" />
                <action android:name="org.cygnusx1.openbu.widget.ACTION_AUTO_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/printer_widget_info" />
        </receiver>
    </application>

</manifest>
